(MetaModel domain=org.sheepy.lily.core.model name=Variable
	imports=org.sheepy.lily.core.model.Types,org.sheepy.lily.core.model.Action

	(JavaWrapper name=LResolvedVariableFeature qualifiedClassName=org.sheepy.lily.core.api.util.FeatureDefinition)

	(Group IVariableResolver)

	(Group IDefinitionContainer
		(+att name=variableDefinition datatype=@VariableDefinition [1..1]))

	(Unit name=VariableDefinition)

	(Definition ChainVariableResolver
		(includes group=@IVariableResolver)
		(+contains name=firstResolver [1..1] @IVariableResolver)
		(+contains name=subResolvers [1..*] @ChainResolver))

	(Definition ChainResolver
		(includes group=@IDefinitionContainer))

	(Group AbstractDefinedVariableResolver
		(includes group=@IVariableResolver)
		(includes group=@IDefinitionContainer))

	(Definition DirectVariableResolver
		(includes group=@AbstractDefinedVariableResolver)
		(-refers name=target lazy [0..1] #LMCore@LMObject))

	(Group VarChangeAction
		(includes group=#Action@Action)
		(+contains name=variableResolver [1..1] @AbstractDefinedVariableResolver))

	(Definition BooleanChangeAction
		(includes group=@VarChangeAction))

	(Definition IntChangeAction
		(includes group=@VarChangeAction)
		(+att name=value datatype=#LMCore@int [1..1]))

	(Definition VarChangeActionPkg
		(+contains name=actions [0..*] @VarChangeAction))

	(Group IModelVariable
		(includes group=#Types@LNamedElement))

	(Definition ModelVariablePkg
		(+contains name=variables [0..*] @IModelVariable))

	(Definition IntVariable
		(includes group=@IModelVariable)
		(+att name=value datatype=#LMCore@int [1..1]))

	(Definition FloatVariable
		(includes group=@IModelVariable)
		(+att name=value datatype=#LMCore@float [1..1]))

	(Definition Vector3fVariable
		(includes group=@IModelVariable)
		(+att name=vector datatype=#Types@Vector3f [0..1]))

	(Definition DurationVariable
		(includes group=@IModelVariable))

	(Group IModelVariableAction)

	(Group IModelVariableActionContainer
		(+contains name=actions [0..*] @IModelVariableAction))

	(Definition SetVariableAction
		(includes group=@IModelVariableAction)
		(+att name=value datatype=#LMCore@string [1..1])
		(+refers name=variable [1..1] @IModelVariable))
)
