	(JavaWrapper name=Vector4d qualifiedClassName=org.joml.Vector4dc
		(serializer convert="if(it!=null){double x=it.x();double y=it.y();double z=it.z();double w=it.w();return (x+\";\"+y+\";\"+z+\";\"+w);}return \"0;0;0;0\";"
